{
  "manifest_version": 3,
  "name": "Super Download Manager",
  "version": "1.0.0",
  "description": "Sniff media on web pages and dispatch downloads to SDM.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sniffer.js"],
      "css": ["hover-button.css"],
      "run_at": "document_idle"
    }
  ]
}
